{
  "name": "@paperclipai/shared",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/paperclipai/paperclip",
  "bugs": {
    "url": "https://github.com/paperclipai/paperclip/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paperclipai/paperclip",
    "directory": "packages/shared"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./telemetry": "./src/telemetry/index.ts",
    "./telemetry/otel-tracing": "./src/telemetry/otel-tracing.ts",
    "./telemetry/otel-tracing.js": "./src/telemetry/otel-tracing.ts",
    "./telemetry/audit-types": "./src/telemetry/audit-types.ts",
    "./telemetry/audit-types.js": "./src/telemetry/audit-types.ts",
    "./telemetry/signing-span-processor": "./src/telemetry/signing-span-processor.ts",
    "./telemetry/signing-span-processor.js": "./src/telemetry/signing-span-processor.ts",
    "./telemetry/faa-trace-enrichment": "./src/telemetry/faa-trace-enrichment.ts",
    "./telemetry/faa-trace-enrichment.js": "./src/telemetry/faa-trace-enrichment.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./telemetry": {
        "types": "./dist/telemetry/index.d.ts",
        "import": "./dist/telemetry/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
